# Docker Compose 配置；本地已提供的连接放在 .env.local（不提交）。
PORT=3001
APP_ORIGIN=https://game.example.com
DB_URL="jdbc:mysql://mysql:3306/dfw?characterEncoding=UTF-8&connectionTimeZone=UTC&allowPublicKeyRetrieval=true&sslMode=DISABLED"
DB_USERNAME=dfw
DB_PASSWORD=replace-with-your-app-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-root-password

# 可选 DeepSeek 机器人；实际密钥只填本机环境或未提交的 .env，留空沿用规则机器人。
DEEPSEEK_API_KEY=
DEEPSEEK_ENABLED=true
DEEPSEEK_MODEL=deepseek-flash
