{
  "name": "party-monopoly",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.13.1 <25"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "npm run compile:server && npm start",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "vue-tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.tools.json --noEmit",
    "compile:server": "mvn -f backend/pom.xml -Dmaven.test.skip=true package",
    "build:web": "vite build",
    "start": "java -jar backend/target/party-monopoly.jar",
    "smoke": "node --env-file-if-exists=.env.local --import tsx scripts/smoke.ts",
    "db:init": "node --env-file-if-exists=.env.local --import tsx scripts/init-database.ts",
    "db:migrate:sqlite": "node --env-file-if-exists=.env.local --import tsx scripts/migrate-sqlite.ts",
    "test:room-layout": "vue-tsc -p tsconfig.test.json --noEmit && vitest run tests/room-layout.test.ts"
  },
  "dependencies": {
    "pinia": "^3.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.6.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "happy-dom": "^21.0.3",
    "mysql2": "^3.24.5",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.9",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.1"
  }
}
