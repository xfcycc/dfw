{
  "version": "classic-v3",
  "stages": [
    {
      "id": "turn_start",
      "handler": "AUTO_HOOK",
      "hook": "TURN_START",
      "steps": []
    },
    {
      "id": "before_roll",
      "handler": "ACTION_WINDOW",
      "phase": "pre_roll",
      "actions": [
        "tradeOffer",
        "card",
        "roll",
        "sellBuilding",
        "mortgage",
        "redeem",
        "sellLand"
      ],
      "exitOn": [
        "roll",
        "replace_roll"
      ]
    },
    {
      "id": "before_dice",
      "handler": "AUTO_HOOK",
      "hook": "BEFORE_DICE",
      "steps": []
    },
    {
      "id": "dice",
      "handler": "ROLL"
    },
    {
      "id": "after_dice",
      "handler": "AUTO_HOOK",
      "hook": "AFTER_DICE",
      "steps": []
    },
    {
      "id": "movement",
      "handler": "MOVEMENT"
    },
    {
      "id": "landing",
      "handler": "LANDING"
    },
    {
      "id": "manage",
      "handler": "ACTION_WINDOW",
      "phase": "manage",
      "actions": [
        "tradeOffer",
        "sellBuilding",
        "mortgage",
        "redeem",
        "sellLand",
        "endTurn"
      ],
      "exitOn": [
        "endTurn"
      ]
    },
    {
      "id": "turn_end",
      "handler": "AUTO_HOOK",
      "hook": "TURN_END",
      "steps": []
    },
    {
      "id": "next_turn",
      "handler": "END_TURN"
    }
  ],
  "cards": [
    {
      "id": "remote",
      "activation": "ACTIVE",
      "stages": [
        "before_roll"
      ],
      "countsAsActive": true,
      "checks": [
        {
          "condition": {
            "op": "ALL",
            "args": [
              {
                "op": "GTE",
                "left": {
                  "ref": "action.point"
                },
                "right": 1
              },
              {
                "op": "LTE",
                "left": {
                  "ref": "action.point"
                },
                "right": 6
              }
            ]
          },
          "error": "请选择 1～6 点"
        }
      ],
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "REPLACE_ROLL",
          "params": {
            "amount": {
              "ref": "action.point"
            }
          },
          "message": "{actor.name} 本次移动 {action.point} 格"
        }
      ]
    },
    {
      "id": "barrier",
      "activation": "ACTIVE",
      "stages": [
        "before_roll"
      ],
      "countsAsActive": true,
      "checks": [
        {
          "condition": {
            "op": "ALL",
            "args": [
              {
                "ref": "targetTile.exists"
              },
              {
                "op": "EQ",
                "left": {
                  "ref": "targetTile.type"
                },
                "right": "property"
              },
              {
                "op": "EQ",
                "left": {
                  "ref": "targetTile.barrier"
                },
                "right": false
              },
              {
                "op": "GTE",
                "left": {
                  "ref": "targetTile.forwardDistance"
                },
                "right": 1
              },
              {
                "op": "LTE",
                "left": {
                  "ref": "targetTile.forwardDistance"
                },
                "right": 6
              }
            ]
          },
          "error": "请选择前方六格内没有路障的地产"
        }
      ],
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "PLACE_BARRIER",
          "params": {
            "tileId": {
              "ref": "action.tileId"
            }
          }
        }
      ]
    },
    {
      "id": "stay",
      "activation": "ACTIVE",
      "stages": [
        "before_roll"
      ],
      "countsAsActive": true,
      "checks": [],
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "REPLACE_ROLL",
          "params": {
            "amount": 0
          },
          "message": "{actor.name} 留在当前位置"
        }
      ]
    },
    {
      "id": "immunity",
      "activation": "RENT",
      "stages": [
        "rent_choice"
      ],
      "countsAsActive": false,
      "checks": [
        {
          "condition": {
            "op": "EQ",
            "left": {
              "ref": "turn.phase"
            },
            "right": "rent"
          },
          "error": "当前没有待支付的租金"
        }
      ],
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "WAIVE_RENT"
        }
      ]
    },
    {
      "id": "demolish",
      "activation": "ACTIVE",
      "stages": [
        "before_roll"
      ],
      "countsAsActive": true,
      "checks": [
        {
          "condition": {
            "op": "ALL",
            "args": [
              {
                "ref": "targetTile.exists"
              },
              {
                "op": "NE",
                "left": {
                  "ref": "targetTile.ownerId"
                },
                "right": null
              },
              {
                "op": "NE",
                "left": {
                  "ref": "targetTile.ownerId"
                },
                "right": {
                  "ref": "actor.id"
                }
              },
              {
                "op": "GT",
                "left": {
                  "ref": "targetTile.level"
                },
                "right": 0
              }
            ]
          },
          "error": "请选择对手有建筑的地产"
        }
      ],
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "DEMOLISH",
          "params": {
            "tileId": {
              "ref": "action.tileId"
            }
          }
        }
      ]
    },
    {
      "id": "swap",
      "activation": "ACTIVE",
      "stages": [
        "before_roll"
      ],
      "countsAsActive": true,
      "checks": [
        {
          "condition": {
            "op": "ALL",
            "args": [
              {
                "ref": "targetPlayer.exists"
              },
              {
                "op": "NE",
                "left": {
                  "ref": "targetPlayer.id"
                },
                "right": {
                  "ref": "actor.id"
                }
              },
              {
                "op": "EQ",
                "left": {
                  "ref": "targetPlayer.bankrupt"
                },
                "right": false
              },
              {
                "op": "EQ",
                "left": {
                  "ref": "targetPlayer.jailed"
                },
                "right": false
              }
            ]
          },
          "error": "请选择未破产、未服刑的对手"
        }
      ],
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "SWAP_POSITION",
          "params": {
            "targetId": {
              "ref": "action.playerId"
            }
          }
        }
      ]
    }
  ],
  "chanceEvents": [
    {
      "id": "global_levy",
      "description": "全体各向银行支付 300，按座位顺序偿债或清算，全部处理后再判断胜负。",
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "CHARGE_ALL",
          "params": {
            "amount": 300
          }
        }
      ]
    },
    {
      "id": "trap_immunity",
      "description": "本人立即获得陷阱免疫，持续三个后续个人回合，休息也计数；重复获得刷新期限，经过路障时路障保留。免疫不影响租金、罚款或灾害。",
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "ADD_STATUS",
          "params": {
            "statusId": "TRAP_IMMUNITY",
            "amount": 3
          }
        }
      ]
    },
    {
      "id": "tornado",
      "description": "随机一块有建筑地产的全部建筑被摧毁，产权保留；业主有 30% 概率获得建筑成本损失的 50% 补偿。无建筑则无损失、无补偿。",
      "steps": [
        {
          "op": "APPLY_EFFECT",
          "type": "DESTROY_BUILDINGS",
          "params": {
            "selector": "RANDOM_BUILT_PROPERTY",
            "probability": 30,
            "compensationPercent": 50
          }
        }
      ]
    }
  ]
}
